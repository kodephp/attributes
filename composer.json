{
    "name": "kode/attributes",
    "type": "library",
    "description": "轻量级、健壮的 PHP 8.3+ 属性读取器，为 kodephp 框架和主流 PHP 框架提供基础组件支持",
    "keywords": [
        "attributes",
        "annotations",
        "reflection",
        "php83",
        "php84",
        "php85",
        "kode",
        "kodephp",
        "metadata"
    ],
    "license": "Apache-2.0",
    "version": "2.1.1",
    "authors": [
        {
            "name": "kode",
            "email": "382601296@qq.com",
            "homepage": "https://github.com/kodephp",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.11 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "Kode\\Attributes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kode\\Attributes\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --no-coverage",
        "test:coverage": "phpunit tests --coverage-html .coverage",
        "fix": "php-cs-fixer fix",
        "check": "php-cs-fixer fix --dry-run",
        "analyse": "phpstan analyse",
        "all": [
            "@check",
            "@test"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/kodephp/attributes/issues",
        "source": "https://github.com/kodephp/attributes",
        "docs": "https://github.com/kodephp/attributes#readme"
    },
    "funding": [
        {
            "type": "custom",
            "url": "https://github.com/sponsors/kodephp"
        }
    ]
}
